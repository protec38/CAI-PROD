FLASK_CONFIG=prod
SECRET_KEY=
# Required only to bootstrap the first admin (minimum 12 characters).
ADMIN_PASSWORD=
POSTGRES_DB=cai
POSTGRES_USER=cai
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg2://cai:CHANGE_ME@db:5432/cai
REDIS_URL=redis://redis:6379/0
FORCE_HTTPS=1
# Set to 1 only behind a trusted reverse proxy that overwrites forwarded headers.
TRUSTED_PROXY_COUNT=0
